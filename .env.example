# Storage provider used by the frontend.
# Keep local for development; switch to organization-api when the backend is deployed.
VITE_STORAGE_PROVIDER=local
VITE_STORAGE_API_BASE_URL=/api
VITE_ORGANIZATION_ID=local-development

# Backend-only values for the future organization API.
# Never expose these as VITE_ variables in a deployed frontend.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cft_tracker
MYSQL_USER=cft_app
MYSQL_PASSWORD=change-me
