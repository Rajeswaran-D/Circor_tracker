# Storage provider used by the frontend.
# Keep local for development; switch to organization-api when the backend is deployed.
VITE_STORAGE_PROVIDER=local
VITE_STORAGE_API_BASE_URL=/api
VITE_ORGANIZATION_ID=local-development

# Backend-only values for MySQL / Aiven (Render deployment).
# Never expose these as VITE_ variables in a deployed frontend.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cft_tracker
MYSQL_USER=cft_app
MYSQL_PASSWORD=change-me

# TLS / SSL Configuration for Cloud Databases (e.g. Aiven, AWS RDS):
# Option A: Path to CA Certificate file (e.g. Render Secret File mounted at /etc/secrets/ca.pem)
MYSQL_SSL_CA_PATH=
# Option B: Raw PEM / Base64 CA Certificate string as an env variable
MYSQL_SSL_CA=
