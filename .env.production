# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Storage provider configuration
VITE_STORAGE_PROVIDER=organization-api
VITE_STORAGE_API_BASE_URL=/api
VITE_ORGANIZATION_ID=circor-flow-technologies

# MySQL Production Database Connection (Docker service name or cloud host)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=cft_tracker
MYSQL_USER=cft_app
MYSQL_PASSWORD=cft_secret_password
